# Generate a unique adapter key and Fernet key for this installation.
ADAPTER_API_KEY=replace-with-a-long-random-value-at-least-32-characters
SIWC_CREDENTIAL_KEY=replace-with-a-generated-fernet-key

# Generate one stable UUID for this adapter host. Do not change it after connecting.
SIWC_HOST_ID=replace-with-a-generated-uuid

# Set these to the externally reachable Open WebUI origin and connection page.
OPEN_WEBUI_PUBLIC_ORIGIN=https://open-webui.example.com
CONNECT_PUBLIC_URL=https://open-webui.example.com/siwc/connect
CONNECT_ADMIN_EMAILS=admin@example.com
TRUSTED_EMAIL_HEADER=X-Auth-Request-Email

# The adapter and Open WebUI must share this private container network.
ADAPTER_INTERNAL_URL=http://siwc-adapter:8080/v1
OPEN_WEBUI_DOCKER_NETWORK=replace-with-your-open-webui-network

# SIWC currently requires these official OpenAI endpoints; custom API proxies are unsupported.
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_AUTH_BASE_URL=https://auth.openai.com

# Structured, content-free request telemetry on stdout (one JSON line per
# /v1/responses request). Logs sizes, item counts, prefix fingerprints, status,
# duration, usage counters and the transport record (full-context vs
# continuation, bytes actually sent upstream, wire reduction) only; never
# prompts, tool results or credentials.
REQUEST_TELEMETRY=true

# Upstream transport for Responses requests:
#   http       - one independent HTTP/SSE Responses request per inbound request
#   websocket  - one persistent authenticated Responses WebSocket per account;
#                tool-loop rounds continue with previous_response_id plus only
#                the new input items. The HTTP path stays available as a
#                bounded fallback whenever the socket cannot serve a request.
# Keep `http` until live acceptance has passed for your resource.
RESPONSES_TRANSPORT=http

# Header carrying an explicit Open WebUI conversation identifier. Configure the
# Open WebUI provider headers as {"X-OpenWebUI-Chat-Id": "{{CHAT_ID}}"} to send
# it. When absent, the adapter correlates conversations only by proving that a
# request strictly extends a recent one.
WS_CONVERSATION_HEADER=X-OpenWebUI-Chat-Id

# Bounded WebSocket lifecycle. The service closes sockets at 60 minutes; the
# adapter rotates earlier, allows this long between events, waits this long for
# the single per-connection lane before falling back to HTTP, and stops
# continuing a conversation whose last request is older than the idle TTL.
WS_CONNECTION_MAX_AGE_SECONDS=3300
WS_EVENT_TIMEOUT_SECONDS=600
WS_OPEN_TIMEOUT_SECONDS=30
WS_LOCK_TIMEOUT_SECONDS=180
WS_LANE_IDLE_TTL_SECONDS=900

# Mark the stable head and every tool result with explicit prompt-cache
# breakpoints so later tool-loop rounds can reuse the earlier cached prefix
# (recommended on GPT-5.6 and later). Keep false when the resource rejects the
# field: the SIWC resource currently rejects prompt_cache_breakpoint and
# prompt_cache_options with HTTP 400 invalid_parameter (2026-10-18).
CACHE_BREAKPOINTS=false

# Send a conversation-derived `prompt_cache_key` when the caller did not
# supply one. Recommended on models before GPT-5.6; on GPT-5.6 and later
# OpenAI routes caches automatically and keys only separate cache accounting.
CACHE_ROUTING_KEY=false

# Persistent adapter data and Docker volume name.
DATA_DIR=/data
